<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Add to Stitch Order</name>
	<id>maps_edge.stitch_order_add</id>

	<param name="action" type="string" gui-hidden="true">add</param>

	<effect needs-live-preview="false">
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no">
				<submenu name="Embroidery" translatable="no">
					<submenu name="Stitch Order" translatable="no" />
				</submenu>
			</submenu>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">stitch_order.py</command>
	</script>

</inkscape-extension>
