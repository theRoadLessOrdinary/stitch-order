<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Preview in Stitch Order</name>
	<id>maps_edge.stitch_order_preview</id>

	<param name="action" type="string" gui-hidden="true">preview</param>
	<param name="untagged" type="optiongroup" appearance="combo" gui-text="Objects without a number">
		<option value="after">Sew after the numbered ones</option>
		<option value="before">Sew before the numbered ones</option>
		<option value="omit">Leave out</option>
	</param>
	<label>Opens the Ink/Stitch simulator on a copy of the document arranged in stitch order. The document itself is not changed.</label>
	<label>Numbering a group numbers everything inside it; a number on an object inside the group overrides it.</label>

	<effect needs-live-preview="false">
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no">
				<submenu name="Embroidery" translatable="no">
					<submenu name="Stitch Order" translatable="no" />
				</submenu>
			</submenu>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">stitch_order.py</command>
	</script>

</inkscape-extension>
